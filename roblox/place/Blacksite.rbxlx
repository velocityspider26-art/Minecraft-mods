	LeftForeArm = {parent="LeftArm", bind={-1.17031,3.84082,0.15538,0.27902,-0.9001,-0.3346,0.17857,-0.29373,0.93906,-0.94353,-0.32177,0.07878}, offset={0,0.68345,0,0.93203,0.36231,0.00746,-0.36239,0.93183,0.01918,0,-0.02058,0.99979}},
