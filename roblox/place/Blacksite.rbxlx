	burstCount = 3,

	magCap = 30,
	magsCarried = 6,

	spreadHip = math.rad(3.4),
	spreadAds = math.rad(0.22),
	spreadMove = math.rad(2.2),
	spreadBloom = math.rad(0.30),
	bloomDecay = math.rad(2.6),

	recoilPitch = math.rad(0.95),
	recoilYaw = math.rad(0.34),
	recoilKick = 0.115,
