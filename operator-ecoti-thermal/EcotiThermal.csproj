<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>EcotiThermal</AssemblyName>
    <RootNamespace>OperatorEcotiThermal</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- The only line you should need to change. Everything else resolves from it. -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\OPERATOR</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader itself. Present after MelonLoader is installed and the game has run once. -->
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />

    <!--
      Generated interop assemblies. These are produced on your machine, by MelonLoader, against
      your specific game build — which is why this project cannot be compiled anywhere else and
      why a prebuilt DLL from someone else's build would not reliably load against yours.
      Wildcarded so new ones are picked up automatically.
    -->
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

</Project>
