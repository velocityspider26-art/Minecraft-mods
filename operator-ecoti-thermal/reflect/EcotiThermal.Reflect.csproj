<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>EcotiThermal</AssemblyName>
    <RootNamespace>OperatorEcotiThermal.Reflect</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>

    <!--
      Explicit compile list. The default glob would also pull in harness/mlmock/Ml.cs — a MOCK
      MelonLoader that exists only so the harness can run outside the loader — and compile it into
      the shipped assembly, which then binds to the fake types instead of the real ones and cannot
      load. Never enable the default items here.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!--
    MelonLoader.dll is the ONLY reference: no Il2Cpp interop assemblies, so no game install is
    needed to build. Every Unity call is resolved at runtime by reflection in src/U.cs.
    Fetch it with the snippet in README.md if lib/ is empty.
  -->
  <ItemGroup>
    <Reference Include="lib\MelonLoader.dll" Private="false" />
  </ItemGroup>

</Project>
