	Head = {parent="Neck", bind={0,4.52468,0.03845,1,0,0,0,1,0,0,0,1}, offset={0,0.20712,-0.07676,1,0,0,0,1,0,0,0,1}},
	LeftShoulder = {parent="Spine1", bind={-0.17271,4.23023,0.11867,-0.05531,-0.89936,-0.43371,0.07346,-0.43686,0.89653,-0.99576,0.01773,0.09023}, offset={-0.17271,0.70735,0.04049,-0.05531,-0.89936,-0.43371,0.03358,-0.4358,0.89942,-0.9979,0.03518,0.05431}},
