@@ -0,0 +1,348 @@
+package shipwrights.genesis.client.lod;
+
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.renderer.MultiBufferSource;
+import net.minecraft.client.renderer.RenderType;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.util.Mth;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.RenderLevelStageEvent;
+import org.joml.Matrix4f;
+import org.joml.Vector3d;
+import shipwrights.genesis.GenesisMod;
+import shipwrights.genesis.client.PlanetSurfaceTextures;
+import shipwrights.genesis.config.GenesisClientConfig;
+import shipwrights.genesis.space.Celestial;
+import shipwrights.genesis.space.surface.PlanetSurfaceData;
+import shipwrights.genesis.space.surface.PlanetSurfaceSampler;
+import shipwrights.genesis.teleportation.CubeFaceFrame;
+import shipwrights.genesis.teleportation.CubeNetSurfaceTransform;
+import shipwrights.genesis.teleportation.SpaceTravelManager;
+
+import java.util.List;
+
+/**
+ * Turns the overworld itself into the orbital cube instead of drawing a second
+ * Earth beneath it.
+ *
+ * <p>There are three layers, all in the parent world's coordinate system:</p>
+ * <ol>
+ *     <li>vanilla chunks remain untouched near the camera;</li>
+ *     <li>cached snapshots of real client chunks replace them after unload;</li>
+ *     <li>the coarse six-face world sample fills everything farther away and
+ *     folds into the other cube faces near the atmosphere boundary.</li>
+ * </ol>
+ *
+ * <p>The camera position supplied by {@link RenderLevelStageEvent} is used for
+ * every calculation. Sable's camera integration already resolves a rider's
+ * local craft transform into parent-world space, so this class never mixes a
+ * sub-level block position with parent-world terrain coordinates.</p>
+ */
+@EventBusSubscriber(value = Dist.CLIENT, modid = GenesisMod.MOD_ID)
+public final class WorldLodEarthRenderer {
+    private static final ResourceLocation OVERWORLD_ID =
+            ResourceLocation.fromNamespaceAndPath("minecraft", "overworld");
+    private static final RenderType LOD_RENDER_TYPE = RenderType.debugQuads();
+    private static boolean loggedActive;
+
+    private WorldLodEarthRenderer() {
+    }
+
+    @SubscribeEvent
+    public static void onRenderLevel(RenderLevelStageEvent event) {
+        if (event.getStage() != RenderLevelStageEvent.Stage.AFTER_SOLID_BLOCKS) {
+            return;
+        }
+
+        Minecraft minecraft = Minecraft.getInstance();
+        ClientLevel level = minecraft.level;
+        if (level == null || !level.dimension().equals(Level.OVERWORLD)) {
+            loggedActive = false;
+            return;
+        }
+
+        Vec3 camera = event.getCamera().getPosition();
+        int startHeight = GenesisClientConfig.getWorldLodStartHeight();
+        if (camera.y < startHeight) {
+            loggedActive = false;
+            return;
+        }
+
+        Celestial earth = GenesisMod.getCelestialForLevel(level);
+        if (earth == null) {
+            return;
+        }
+
+        PlanetSurfaceData surface = PlanetSurfaceTextures.surface(OVERWORLD_ID);
+        CubeNetSurfaceTransform transform = new CubeNetSurfaceTransform(
+                earth.getActualSize(), SpaceTravelManager.entryPadding(earth.getActualSize()));
+        CubeNetSurfaceTransform.Face currentFace = transform.faceContaining(camera.x, camera.z);
+        if (currentFace == null) {
+            currentFace = CubeNetSurfaceTransform.Face.UP;
+        }
+
+        float configuredLodAlpha = smoothstep((float) ((camera.y - startHeight)
+                / Math.max(1.0, GenesisClientConfig.getWorldLodFullHeight() - startHeight)));
+        int vanillaRadius = Math.max(64, minecraft.options.getEffectiveRenderDistance() * 16);
+        // Vanilla's far plane is three-dimensional. Once the camera is more
+        // than roughly one render radius above the world's top sections, even
+        // the chunks directly underneath it can disappear. This replacement
+        // term closes that centre hole instead of only drawing a distant ring.
+        float verticalReplacement = smoothstep((float) ((camera.y - (level.getMaxBuildHeight() - 64.0))
+                / Math.max(128.0, vanillaRadius * 1.5)));
+        float lodAlpha = Math.max(configuredLodAlpha, verticalReplacement);
+        float cubeAlpha = cubeRevealAlpha(camera.y);
+        if (lodAlpha <= 0.001f && cubeAlpha <= 0.001f) {
+            return;
+        }
+
+        MultiBufferSource.BufferSource source = minecraft.renderBuffers().bufferSource();
+        VertexConsumer buffer = source.getBuffer(LOD_RENDER_TYPE);
+        Matrix4f view = new Matrix4f(event.getModelViewMatrix());
+
+        int lodRadius = GenesisClientConfig.getWorldLodRadius();
+        double vanillaGroundRadius = vanillaGroundRadius(camera.y, level.getMaxBuildHeight(), vanillaRadius);
+        renderLiveTiles(event, buffer, view, camera, transform, currentFace,
+                lodAlpha, vanillaRadius, vanillaGroundRadius, lodRadius);
+        if (surface != null && surface.isValid()) {
+            renderGlobalWorld(event, buffer, view, camera, transform, currentFace,
+                    surface, lodAlpha, cubeAlpha, vanillaRadius, vanillaGroundRadius, lodRadius);
+        }
+
+        source.endBatch(LOD_RENDER_TYPE);
+        RenderSystem.enableDepthTest();
+        RenderSystem.depthMask(true);
+
+        if (!loggedActive) {
+            loggedActive = true;
+            GenesisMod.LOGGER.info(
+                    "[WORLD-LOD] live overworld LOD active at y={}; current face={}, cube reveal begins at y={}",
+                    Mth.floor(camera.y), currentFace, GenesisClientConfig.getCurrentPlanetRevealHeight());
+        }
+    }
+
+    private static void renderLiveTiles(RenderLevelStageEvent event, VertexConsumer buffer,
+                                        Matrix4f view, Vec3 camera,
+                                        CubeNetSurfaceTransform transform,
+                                        CubeNetSurfaceTransform.Face currentFace,
+                                        float lodAlpha, int vanillaRadius, double vanillaGroundRadius, int lodRadius) {
+        List<WorldLodTileCache.Tile> tiles = WorldLodTileCache.tilesNear(
+                camera.x, camera.z, Math.min(lodRadius, vanillaRadius * 3.0));
+        for (WorldLodTileCache.Tile tile : tiles) {
+            double centerX = tile.minX() + WorldLodTileCache.TILE_SIZE * 0.5;
+            double centerZ = tile.minZ() + WorldLodTileCache.TILE_SIZE * 0.5;
+            if (transform.faceContaining(centerX, centerZ) != currentFace) {
+                continue;
+            }
+            double distance = horizontalDistance(camera.x, camera.z, centerX, centerZ);
+            double near0 = Math.max(0.0, vanillaGroundRadius * 0.72 - 32.0);
+            double near1 = Math.max(24.0, vanillaGroundRadius * 1.08 + 16.0);
+            float alpha = lodAlpha * distanceBand(distance, near0, near1,
+                    lodRadius * 0.88, lodRadius);
+            if (alpha <= 0.002f) {
+                continue;
+            }
+
+            double minY = Short.MAX_VALUE;
+            double maxY = Short.MIN_VALUE;
+            for (short height : tile.heights()) {
+                minY = Math.min(minY, height);
+                maxY = Math.max(maxY, height);
+            }
+            if (!event.getFrustum().isVisible(new AABB(tile.minX(), minY - 2.0, tile.minZ(),
+                    tile.minX() + WorldLodTileCache.TILE_SIZE, maxY + 2.0,
+                    tile.minZ() + WorldLodTileCache.TILE_SIZE))) {
+                continue;
+            }
+
+            for (int z = 0; z < WorldLodTileCache.CELLS; z++) {
+                for (int x = 0; x < WorldLodTileCache.CELLS; x++) {
+                    addLiveVertex(buffer, view, camera, tile, x, z + 1, alpha);
+                    addLiveVertex(buffer, view, camera, tile, x + 1, z + 1, alpha);
+                    addLiveVertex(buffer, view, camera, tile, x + 1, z, alpha);
+                    addLiveVertex(buffer, view, camera, tile, x, z, alpha);
+                }
+            }
+        }
+    }
+
+    private static void addLiveVertex(VertexConsumer buffer, Matrix4f view, Vec3 camera,
+                                      WorldLodTileCache.Tile tile, int x, int z, float alpha) {
+        int index = tile.index(x, z);
+        double worldX = tile.minX() + x * (WorldLodTileCache.TILE_SIZE / (double) WorldLodTileCache.CELLS);
+        double worldZ = tile.minZ() + z * (WorldLodTileCache.TILE_SIZE / (double) WorldLodTileCache.CELLS);
+        double worldY = tile.heights()[index] + 0.04;
+        addColourVertex(buffer, view,
+                worldX - camera.x, worldY - camera.y, worldZ - camera.z,
+                tile.colours()[index], alpha);
+    }
+
+    private static void renderGlobalWorld(RenderLevelStageEvent event, VertexConsumer buffer,
+                                          Matrix4f view, Vec3 camera,
+                                          CubeNetSurfaceTransform transform,
+                                          CubeNetSurfaceTransform.Face currentFace,
+                                          PlanetSurfaceData surface,
+                                          float lodAlpha, float cubeAlpha,
+                                          int vanillaRadius, double vanillaGroundRadius, int lodRadius) {
+        int quality = GenesisClientConfig.getWorldLodQuality();
+        int currentStep = quality == 1 ? 2 : 1;
+        int foldedStep = quality == 3 ? 1 : quality == 2 ? 2 : 4;
+        double faceHalf = transform.faceHalfSpan();
+        double faceSpan = transform.faceSpan();
+        double currentCenterX = transform.faceCenterX(currentFace);
+        double currentCenterZ = transform.faceCenterZ(currentFace);
+        double cubeCenterY = surface.seaLevel() - faceHalf;
+        int resolution = PlanetSurfaceSampler.RESOLUTION;
+
+        for (CubeNetSurfaceTransform.Face face : CubeNetSurfaceTransform.Face.values()) {
+            boolean current = face == currentFace;
+            float faceAlpha = current ? lodAlpha : cubeAlpha;
+            if (faceAlpha <= 0.002f) {
+                continue;
+            }
+            int step = current ? currentStep : foldedStep;
+            for (int row = 0; row < resolution; row += step) {
+                int row1 = Math.min(resolution, row + step);
+                double v0 = (row / (double) resolution - 0.5) * faceSpan;
+                double v1 = (row1 / (double) resolution - 0.5) * faceSpan;
+                for (int column = 0; column < resolution; column += step) {
+                    int column1 = Math.min(resolution, column + step);
+                    double u0 = (column / (double) resolution - 0.5) * faceSpan;
+                    double u1 = (column1 / (double) resolution - 0.5) * faceSpan;
+
+                    float cellAlpha = faceAlpha;
+                    if (current) {
+                        double cellX = currentCenterX + (u0 + u1) * 0.5;
+                        double cellZ = currentCenterZ + (v0 + v1) * 0.5;
+                        double distance = horizontalDistance(camera.x, camera.z, cellX, cellZ);
+                        double near0 = Math.max(0.0, vanillaGroundRadius * 0.82 - 48.0);
+                        double near1 = Math.max(32.0, vanillaGroundRadius * 1.18 + 24.0);
+                        float flatBand = distanceBand(distance, near0, near1,
+                                lodRadius * 0.86, lodRadius);
+                        // Before the cube reveal, only a wide terrain field around
+                        // the player is visible. This hides the finite face edge
+                        // while still replacing unloaded chunks. As the cube
+                        // reveal rises, the complete face takes over.
+                        cellAlpha *= Math.max(flatBand, cubeAlpha);
+                        if (WorldLodTileCache.covers(cellX, cellZ)
+                                && distance <= Math.min(lodRadius, vanillaRadius * 3.0)) {
+                            cellAlpha *= 0.03f;
+                        }
+                    }
+                    if (cellAlpha <= 0.002f) {
+                        continue;
+                    }
+
+                    Vector3d p00 = worldPoint(face, currentFace, u0, v0, faceHalf,
+                            elevation(surface, face, column, row), currentCenterX, cubeCenterY, currentCenterZ);
+                    Vector3d p10 = worldPoint(face, currentFace, u1, v0, faceHalf,
+                            elevation(surface, face, column1, row), currentCenterX, cubeCenterY, currentCenterZ);
+                    Vector3d p11 = worldPoint(face, currentFace, u1, v1, faceHalf,
+                            elevation(surface, face, column1, row1), currentCenterX, cubeCenterY, currentCenterZ);
+                    Vector3d p01 = worldPoint(face, currentFace, u0, v1, faceHalf,
+                            elevation(surface, face, column, row1), currentCenterX, cubeCenterY, currentCenterZ);
+
+                    double minX = Math.min(Math.min(p00.x, p10.x), Math.min(p11.x, p01.x));
+                    double maxX = Math.max(Math.max(p00.x, p10.x), Math.max(p11.x, p01.x));
+                    double minY = Math.min(Math.min(p00.y, p10.y), Math.min(p11.y, p01.y));
+                    double maxY = Math.max(Math.max(p00.y, p10.y), Math.max(p11.y, p01.y));
+                    double minZ = Math.min(Math.min(p00.z, p10.z), Math.min(p11.z, p01.z));
+                    double maxZ = Math.max(Math.max(p00.z, p10.z), Math.max(p11.z, p01.z));
+                    if (!event.getFrustum().isVisible(new AABB(minX, minY, minZ, maxX, maxY, maxZ))) {
+                        continue;
+                    }
+
+                    addGlobalVertex(buffer, view, camera, p01,
+                            colour(surface, face, column, row1), cellAlpha);
+                    addGlobalVertex(buffer, view, camera, p11,
+                            colour(surface, face, column1, row1), cellAlpha);
+                    addGlobalVertex(buffer, view, camera, p10,
+                            colour(surface, face, column1, row), cellAlpha);
+                    addGlobalVertex(buffer, view, camera, p00,
+                            colour(surface, face, column, row), cellAlpha);
+                }
+            }
+        }
+    }
+
+    private static Vector3d worldPoint(CubeNetSurfaceTransform.Face face,
+                                       CubeNetSurfaceTransform.Face currentFace,
+                                       double u, double v, double halfExtent, double elevation,
+                                       double centerX, double centerY, double centerZ) {
+        Vector3d celestial = CubeFaceFrame.cubePoint(face, u, v, halfExtent, elevation);
+        Vector3d surface = CubeFaceFrame.celestialToSurface(currentFace, celestial);
+        return surface.add(centerX, centerY, centerZ);
+    }
+
+    private static double elevation(PlanetSurfaceData surface, CubeNetSurfaceTransform.Face face,
+                                    int x, int z) {
+        int resolution = PlanetSurfaceSampler.RESOLUTION;
+        int sx = Mth.clamp(x, 0, resolution - 1);
+        int sz = Mth.clamp(z, 0, resolution - 1);
+        return surface.heights()[PlanetSurfaceData.index(face, sx, sz)] - surface.seaLevel();
+    }
+
+    private static int colour(PlanetSurfaceData surface, CubeNetSurfaceTransform.Face face,
+                              int x, int z) {
+        int resolution = PlanetSurfaceSampler.RESOLUTION;
+        int sx = Mth.clamp(x, 0, resolution - 1);
+        int sz = Mth.clamp(z, 0, resolution - 1);
+        return surface.colours()[PlanetSurfaceData.index(face, sx, sz)];
+    }
+
+    private static void addGlobalVertex(VertexConsumer buffer, Matrix4f view, Vec3 camera,
+                                        Vector3d point, int argb, float alpha) {
+        addColourVertex(buffer, view,
+                point.x - camera.x, point.y - camera.y, point.z - camera.z,
+                argb, alpha);
+    }
+
+    private static void addColourVertex(VertexConsumer buffer, Matrix4f view,
+                                        double x, double y, double z,
+                                        int argb, float alpha) {
+        int r = (argb >> 16) & 0xFF;
+        int g = (argb >> 8) & 0xFF;
+        int b = argb & 0xFF;
+        int a = Mth.clamp((int) (alpha * 255.0f), 0, 255);
+        buffer.addVertex(view, (float) x, (float) y, (float) z).setColor(r, g, b, a);
+    }
+
+    private static float cubeRevealAlpha(double cameraY) {
+        double start = GenesisClientConfig.getCurrentPlanetRevealHeight();
+        double end = Math.max(start + 1.0, shipwrights.genesis.config.GenesisCommonConfig.getAtmosphereExitHeight());
+        return smoothstep((float) ((cameraY - start) / (end - start)));
+    }
+
+    private static float distanceBand(double distance, double near0, double near1,
+                                      double far0, double far1) {
+        float near = smoothstep((float) ((distance - near0) / Math.max(1.0, near1 - near0)));
+        float far = 1.0f - smoothstep((float) ((distance - far0) / Math.max(1.0, far1 - far0)));
+        return Mth.clamp(near * far, 0.0f, 1.0f);
+    }
+
+
+    private static double vanillaGroundRadius(double cameraY, double terrainCeiling, double renderRadius) {
+        double vertical = Math.max(0.0, cameraY - terrainCeiling);
+        double squared = renderRadius * renderRadius - vertical * vertical;
+        return squared <= 0.0 ? 0.0 : Math.sqrt(squared);
+    }
+
+    private static double horizontalDistance(double x0, double z0, double x1, double z1) {
+        double dx = x1 - x0;
+        double dz = z1 - z0;
+        return Math.sqrt(dx * dx + dz * dz);
+    }
+
+    private static float smoothstep(float value) {
+        float clamped = Mth.clamp(value, 0.0f, 1.0f);
+        return clamped * clamped * (3.0f - 2.0f * clamped);
+    }
+}
