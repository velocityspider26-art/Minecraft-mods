	RightToeBase = {parent="RightFoot", bind={0.53473,0.06686,-0.25247,-0.99874,0.05018,0.00271,-0.00094,0.03525,-0.99938,-0.05025,-0.99812,-0.03516}, offset={0,0.57771,0,0.99541,-0.05803,0.07613,0,0.7953,0.60622,-0.09572,-0.60344,0.79164}},
}

-- Palm frames, in each wrist bone's local space. X runs along the
-- knuckle line toward the index finger, Z points out of the palm.
-- A hand meets a grip when this frame is laid on the weapon's
-- matching frame, which is what puts the fingers on the grip
-- instead of near it:  wrist = weaponCF * weaponGrip * palm:Inverse()
M.HANDS = {
	Left = {0.01908,0.18396,-0.02855,0.99291,0.11872,0.00667,0.11842,-0.99236,0.03447,0.01071,-0.03344,-0.99938},
