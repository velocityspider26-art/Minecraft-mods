<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>EcotiThermal</AssemblyName>
    <RootNamespace>OperatorEcotiThermal.Reflect</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    The whole point of this variant: MelonLoader.dll is the ONLY reference. No Il2Cpp interop
    assemblies, so no game install is needed to build it. Every Unity call is resolved at runtime
    by reflection in U.cs.
  -->
  <ItemGroup>
    <Reference Include="lib\MelonLoader.dll" Private="false" />
  </ItemGroup>

</Project>
